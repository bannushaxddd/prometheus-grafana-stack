# Copy:  copy .env.example .env

# ── Grafana login ─────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=AdminMonitor2024
GRAFANA_VIEWER_USER=viewer
GRAFANA_VIEWER_PASSWORD=ViewerMonitor2024
GRAFANA_ROOT_URL=http://localhost:3001

# ── MySQL ─────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=RootMysql2024
MYSQL_DATABASE=demo
MYSQL_USER=app
MYSQL_PASSWORD=AppMysql2024
MYSQL_EXPORTER_USER=exporter
MYSQL_EXPORTER_PASSWORD=ExporterMysql2024

# ── MongoDB ───────────────────────────────────────────────────────────
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=RootMongo2024

# ── Slack alerts (optional) ───────────────────────────────────────────
